# Local: copy to .streamlit/secrets.toml. Streamlit Cloud: paste into App settings -> Secrets.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_KEY = "your secret / service_role key (never share or commit)"
GEMINI_API_KEY = "your Google AI Studio key"
ADMIN_PASSWORD = "choose a long password"

# Optional
# EMBED_MODEL = "gemini-embedding-001"
# EMBED_TPM = 24000          # free tier allows 30,000 tokens/minute; stay under it
# MIN_SIMILARITY = 0.6
